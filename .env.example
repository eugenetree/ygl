# App environment — set to "development" to seed a small word list instead of the full dictionary
APP_ENV=development

# PostgreSQL — the credentials are required; compose refuses to start without them
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db
# Compose hardcodes the host and port; these are read by what runs on the host,
# such as `make db-rollback` or the API started with npm
DB_HOST=host
DB_PORT=1234

# Elasticsearch
ES_NODE=http://elasticsearch:9200

# Telegram notifications — required; compose refuses to start without them
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# API service — leave unset to keep the API container exiting on start
IS_API_ENABLED=true
# Compose hardcodes the port; set it when running the API on the host
API_PORT=3001
# The origin browsers reach the site and the API on, the API being its /api path
# (ADR-0008): scheme, host and port, no path or trailing slash.
# http://localhost:3000 locally, where next dev forwards /api to the API, and
# https://saythis.co in production. Session cookies are Secure when it is https.
# The API refuses to start without it.
PUBLIC_ORIGIN=http://localhost:3000
# Signs session cookies. At least 32 characters: openssl rand -base64 32
# The API refuses to start without it.
BETTER_AUTH_SECRET=
# The Google OAuth client listeners sign in with (Google Cloud Console → APIs &
# Services → Credentials, a "Web application" client). Its authorised redirect
# URIs must include $PUBLIC_ORIGIN/api/auth/callback/google for every
# environment, e.g. http://localhost:3000/api/auth/callback/google. The API
# refuses to start without them.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# VPN Credentials for Scraper
VPN_USER=your_username
VPN_PASS=your_password
VPN_CONFIG_B64=router_config.ovpn_in_b64

# yt-dlp cookies — optional fallback when YouTube still challenges the scraper's IP
# ("Sign in to confirm you're not a bot") despite PO tokens. Use a dedicated Google
# account. Export cookies.txt from a private browser window (then close it so the
# session is not rotated), then: node scripts/cookies-to-b64.js cookies.txt
YTDLP_COOKIES_B64=cookies_b64

# PO token provider (pot-provider service in docker-compose.yml) that yt-dlp asks
# for the proof-of-origin tokens YouTube requires. Defaults to the sidecar; set
# to an empty value to run yt-dlp without one.
# YTDLP_POT_PROVIDER_URL=http://127.0.0.1:4416

# Cloudflare R2 — used for large file downloads via S3 Compatibility API (make r2-download)
R2_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=saythis
R2_FOLDER=saythis-saythis-trr9pp_db
