# Grouped by which execution context reads a variable, not by subsystem — the
# same name means different things on the host and inside a container, and that
# ambiguity is what this grouping exists to remove.
#
# Nothing here configures how the application reaches Postgres or
# Elasticsearch: those addresses are in-network wiring between services and
# live in docker-compose.yml as literals. A variable naming a service address
# would mean one thing to a container and another to a host command that
# sourced this file, which is the confusion these groups exist to prevent.

# ── Passed into containers ──────────────────────────────────────────────────
# docker-compose.yml interpolates these into a service's environment, so their
# values are read inside the container.

# Selects the seed word list for the scraper: "development" -> dev.json, else prod.json
APP_ENV=development

# PostgreSQL — used to provision the db service and to connect to it from the
# bot, scraper, sync-elastic and migrator services
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db

# Telegram notifications — read by the bot and scraper services
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Serves the caption search HTTP API from the api service when set
IS_API_ENABLED=

# VPN credentials for the scraper service
VPN_USER=your_username
VPN_PASS=your_password
VPN_CONFIG_B64=router_config.ovpn_in_b64

# yt-dlp cookies — needed when YouTube requires auth ("Sign in to confirm you're not a bot")
# Export cookies.txt from your browser, then: base64 -w 0 cookies.txt
YTDLP_COOKIES_B64=cookies_b64

# ── Used on the host ────────────────────────────────────────────────────────
# Never reach a container. These are consumed where the command runs — by
# Compose as it builds the stack, and by the Makefile.

# Host directory Compose mounts as the container log dir (server uses /opt/ygl/logs)
LOGS_DIR=./logs

# Cloudflare R2 — read by the Makefile for large file downloads via the
# S3 Compatibility API (make r2-download-latest)
R2_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=saythis
R2_FOLDER=saythis-saythis-trr9pp_db
