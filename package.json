{
  "name": "youglish",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "db:migration:run": "npx tsx src/db/scripts/run-migrations.ts",
    "db:migration:rollback": "npx tsx src/db/scripts/rollback-migration.ts",
    "db:migration:create-new": "npx tsx src/db/scripts/create-migration-file.ts",
    "db:seed:dev": "npx tsx src/db/scripts/seed-dev.ts",
    "test": "node --test --import tsx --test-global-setup=src/db/testing/global-setup.mjs \"src/**/!(*.net).test.ts\"",
    "test:unit": "node --test --import tsx \"src/**/!(*.db|*.net).test.ts\"",
    "test:net": "node --test --import tsx \"src/**/*.net.test.ts\"",
    "test:db:reset": "docker ps -aq --filter label=yg.test-postgres | xargs -r docker rm -f -v",
    "clean": "rm -rf dist/*",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "start:bot": "node dist/src/main-bot.js",
    "start:scraper": "node dist/src/main-scraper.js",
    "start:elastic": "node dist/src/main-elastic.js",
    "start:api": "node dist/src/main-api.js",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24 <25"
  },
  "lint-staged": {
    "*.{ts,js,json}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/preset-typescript": "^7.28.5",
    "@biomejs/biome": "^2.4.16",
    "@testcontainers/postgresql": "^12.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.12.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.6",
    "axios": "^1.7.7",
    "compromise": "^14.15.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "inversify": "^7.9.1",
    "kysely": "^0.27.5",
    "lodash-es": "^4.17.21",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "telegraf": "^4.16.3",
    "valibot": "^0.37.0",
    "youtube-search-api": "^1.2.2",
    "ytdlp-nodejs": "^3.4.2",
    "zod": "^3.23.8"
  }
}
